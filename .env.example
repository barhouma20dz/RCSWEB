# ============================================================
# نادي الرائد الرياضي — متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم قبل التشغيل
# ============================================================

# قاعدة البيانات (SQLite عبر Prisma)
DATABASE_URL=file:../db/custom.db

# مفتاح توقيع جلسات الدخول — إلزامي (بدونه يرفض التطبيق العمل)
# يجب أن يكون 64 خانة ست عشرية على الأقل
# للتوليد:  openssl rand -hex 32
AUTH_SECRET=ضع-هنا-مفتاحاً-ست-عشرياً-بطول-64-خانة-على-الأقل
